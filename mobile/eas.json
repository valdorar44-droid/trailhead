{
  "cli": {
    "version": "21.0.2",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.gettrailhead.app",
        "EXPO_PUBLIC_TELEMETRY_QA_ENABLED": "true",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0.1"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "android": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.gettrailhead.app",
        "EXPO_PUBLIC_TELEMETRY_QA_ENABLED": "false",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0.1"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "com.trailhead.app",
        "track": "production",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6763677349"
      }
    }
  }
}
