          "url": "https://mapservices.nps.gov/arcgis/rest/services/NationalDatasets/NPS_Public_POIs_Geographic/FeatureServer/0",
          "maps_to": ["place"]
        },
        {
          "id": "nps-public-trails",
          "name": "NPS Public Trails",
          "url": "https://mapservices.nps.gov/arcgis/rest/services/NationalDatasets/NPS_Public_Trails_Geographic/FeatureServer/0",
          "maps_to": ["trail"]
        },
        {
          "id": "nps-public-roads",
          "name": "NPS Public Roads",
          "url": "https://mapservices.nps.gov/arcgis/rest/services/NationalDatasets/NPS_Public_Roads_Geographic/FeatureServer/0",
          "maps_to": ["access_reference"]
        },
        {
          "id": "nps-public-buildings",
          "name": "NPS Public Buildings",
          "url": "https://mapservices.nps.gov/arcgis/rest/services/NationalDatasets/NPS_Public_Buildings_Geographic/FeatureServer/0",
          "maps_to": ["facility"]
        },
        {
          "id": "nps-public-parking",
          "name": "NPS Public Parking Lots",
          "url": "https://mapservices.nps.gov/arcgis/rest/services/NationalDatasets/NPS_Public_ParkingLots_Geographic/FeatureServer/0",
          "maps_to": ["place", "facility"]
        },
        {
          "id": "nps-wilderness",
          "name": "NPS Legislated Wilderness",
          "url": "https://mapservices.nps.gov/arcgis/rest/services/Wilderness/NPS_Legislated_Wilderness/FeatureServer/0",
          "maps_to": ["land_unit"]
