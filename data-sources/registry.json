    },
    {
      "id": "nws",
      "agency": "NOAA / National Weather Service",
      "source_name": "NWS API",
      "source_type": "dynamic-api-cache",
      "api_base": "https://api.weather.gov",
      "source_url": "https://www.weather.gov/documentation/services-web-api",
      "attribution_text": "National Weather Service",
      "license_note": "Public weather data; cache briefly and expire safety records.",
      "refresh_type": "dynamic",
      "refresh_frequency": "hourly or less",
      "enabled": false,
      "endpoints": ["alerts/active", "points/{lat},{lon}"]
    },
    {
      "id": "firms-nifc",
      "agency": "NASA FIRMS / NIFC",
      "source_name": "Active Fire and Current Fire Perimeters",
      "source_type": "dynamic-api-cache",
      "source_url": "https://firms.modaps.eosdis.nasa.gov/download/",
      "api_base": "https://firms.modaps.eosdis.nasa.gov/usfs/api/area/",
      "attribution_text": "NASA FIRMS / NIFC",
      "license_note": "Cache briefly; never show stale active fire data as current.",
      "refresh_type": "dynamic",
      "refresh_frequency": "hourly or less",
      "enabled": false,
      "env": ["FIRMS_MAP_KEY"]
    }
