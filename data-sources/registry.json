      ]
    },
    {
      "id": "ridb",
      "agency": "Recreation.gov",
      "source_name": "Recreation Information Database",
      "source_type": "bulk-or-api-cache",
      "source_url": "https://ridb.recreation.gov/docs",
      "download_url": "https://ridb.recreation.gov/download",
      "api_base": "https://ridb.recreation.gov/api/v1",
