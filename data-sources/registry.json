{
  "schema_version": 1,
  "updated_at": "2026-07-02",
  "sources": [
    {
      "id": "nps-api",
      "agency": "National Park Service",
      "source_name": "NPS Data API",
      "source_type": "api-cache",
      "source_url": "https://www.nps.gov/subjects/developer/api-documentation.htm",
      "api_base": "https://developer.nps.gov/api/v1",
      "attribution_text": "National Park Service",
      "license_note": "National Park Service public data; preserve source attribution.",
      "refresh_type": "scheduled-cache",
      "refresh_frequency": "weekly for general content; hourly or every few hours for alerts",
      "enabled": true,
      "env": ["NPS_API_KEY"],
      "endpoints": [
        "parks",
        "campgrounds",
        "visitorcenters",
        "thingstodo",
        "places",
        "activities",
        "alerts",
        "articles",
        "events",
        "newsreleases"
      ]
    },
    {
      "id": "nps-national-spatial",
      "agency": "National Park Service",
      "source_name": "NPS National Spatial Services",
