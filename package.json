{
  "name": "trailhead-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/export_website_app.mjs && cd dashboard/site && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "data:download": "node scripts/data/download.ts",
    "data:import": "node scripts/data/import.ts",
    "data:normalize": "node scripts/data/normalize.ts",
    "data:dedupe": "node scripts/data/dedupe.ts",
    "data:refresh-dynamic": "node scripts/data/refresh-dynamic.ts",
    "data:build-search": "node scripts/data/build-search.ts",
    "data:build-tiles": "node scripts/data/build-tiles.ts",
    "data:audit-catalog": "python3 scripts/data/audit_canonical_catalog.py",
    "data:audit-explore-filters": "python3 scripts/data/audit_explore_filter_coverage.py",
    "data:build-canonical-indexes": "python3 scripts/data/build_canonical_serving_indexes.py",
    "data:validate": "node scripts/data/validate.ts",
    "dev": "cd dashboard/site && ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "export:webapp": "node scripts/export_website_app.mjs",
    "preview": "cd dashboard/site && ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/react": "5.0.3",
    "@astrojs/sitemap": "3.7.2",
    "@iconify-json/lucide": "^1.2.75",
    "@nanostores/react": "^1.0.0",
    "astro": "6.1.6",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.554.0",
    "maplibre-gl": "^5.24.0",
    "nanostores": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.0.0"
  }
}
